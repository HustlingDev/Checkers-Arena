rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Users collection rules:
    // Read: anyone can view player profiles for lobby matchmaking & leaderboard.
    // Create: allowed for new user registration or guest sessions.
    // Update: allowed for the owner of the document or matching self-id payload.
    // Delete: restricted to account owner or guest cleanup.
    match /users/{userId} {
      allow read: if true;
      allow create: if true;
      allow update: if (isOwner(userId) || request.resource.data.id == userId)
                    && (request.resource.data.walletBalance == null || request.resource.data.walletBalance >= 0);
      allow delete: if isOwner(userId) || (userId.matches('^guest_.*') && (resource.data.walletBalance == null || resource.data.walletBalance == 0));
    }

    // Transactions collection rules:
    // Highly protected ledger: IMMUTABLE once created.
    // Transactions can NEVER be edited, modified, or deleted by any client or hacker!
    match /transactions/{txId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }

    // Claimed bonus phones registry:
    // Immutable to prevent repeat bonus claiming exploits
    match /claimed_bonus_phones/{phoneId} {
      allow read, create: if true;
      allow update, delete: if false;
    }

    // Direct Challenge requests between players
    match /challenges/{challengeId} {
      allow read, write, create, update, delete: if true;
    }

    // Match Rooms collection rules for real-time multiplayer
    match /rooms/{roomId} {
      allow read, write, create, update, delete: if true;

      // In-game chat subcollection
      match /chat/{chatId} {
        allow read, write, create, update, delete: if true;
      }
    }

    // Global Chat messages: immutable once written
    match /chat/{messageId} {
      allow read, create: if true;
      allow update, delete: if false;
    }

    // Leaderboards collection
    match /leaderboard/{entry} {
      allow read, write: if true;
    }

    // Fallback: Default deny any unknown collection
    match /{document=**} {
      allow read, write: if false;
    }
  }
}


